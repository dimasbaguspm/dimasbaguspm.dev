# --- GitHub-backed content store ---
# Posts are Markdown in content/posts/ of the repo, fetched via the GitHub
# API at request time (SSR) — a git commit goes live without a rebuild.
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=dimasbaguspm/dimasbaguspm.dev
# Directory inside the repo that holds the Markdown posts.
POSTS_PATH=content/posts

SITE_URL=https://dimasbaguspm.dev
