# OIDC / session (Authentik)
OIDC_ISSUER=https://sso.yourdomain.com
OIDC_CLIENT_ID=your-authentik-client-id
OIDC_CLIENT_SECRET=your-authentik-client-secret
OIDC_ALLOWED_SUBS=your-authentik-sub
SITE_URL=https://dimasbaguspm.dev

# Server-side HMAC key for the session cookie. Use a long random string (>=32 chars).
# NOTE: this is read from the runtime environment (process.env), NOT import.meta.env,
# so it is NOT inlined at build time and can differ between build and deploy.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- GitHub-backed content store (Phase 7) ---
# The admin writes articles/projects/assets directly to the repo via the GitHub
# REST API; a "Publish" action merges the content branch into main → rebuild.
# No server filesystem/volume needed — only this token.
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=dimasbaguspm/dimasbaguspm.dev
# Branch the admin commits to (accumulates edits); "Publish" merges into main.
GITHUB_CONTENT_BRANCH=content
# Production branch the site builds/deploys from.
GITHUB_BRANCH=main
# Commit author identity (defaults to dimasbaguspm if unset).
GITHUB_COMMIT_NAME=dimasbaguspm
GITHUB_COMMIT_EMAIL=dimasbaguspm@users.noreply.github.com

# Max upload size in bytes (default 10 MB).
ASSET_MAX_BYTES=
