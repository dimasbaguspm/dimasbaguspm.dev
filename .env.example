# Posts and profile come from this GitHub repo, fetched at request time.
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPOSITORY=dimasbaguspm/dimasbaguspm.dev

# Redis/Valkey response cache (both speak RESP) — empty → direct octokit hits.
REDIS_HOST=

# OpenTelemetry collector: traces + logs (e.g. "localhost:4318") — empty → off.
OTEL_HOST=

# Umami analytics — script omitted when empty.
UMAMI_SRC=
UMAMI_ID=