# OIDC / session (Authentik)
OIDC_ISSUER=https://sso.yourdomain.com
OIDC_CLIENT_ID=your-authentik-client-id
OIDC_CLIENT_SECRET=your-authentik-client-secret
OIDC_ALLOWED_SUBS=your-authentik-sub
SITE_URL=https://dimasbaguspm.dev

# Server-side HMAC key for the session cookie. Use a long random string (>=32 chars).
# NOTE: this is read from the runtime environment (process.env), NOT import.meta.env,
# so it is NOT inlined at build time and can differ between build and deploy.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where articles/projects are read & written by the admin API. Absolute path to the
# content root (a mounted volume in prod). In prod point this at the repo content dir.
# Leave unset to default to this repo's ./src/content.
CONTENT_DIR=
