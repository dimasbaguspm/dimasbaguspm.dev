---
import { ChevronLeft, ChevronRight } from "lucide-astro";
import type { ProjectAsset } from "../lib/projects";
interface Props {
  assets: ProjectAsset[];
}
const { assets } = Astro.props;
---
<div class="overflow-hidden rounded-lg border border-neutral-200" data-carousel>
  <div class="relative flex min-h-[240px] items-center justify-center bg-neutral-950 p-4">
    {assets.map((a, i) =>
      a.video ? (
        <video
          data-slide
          src={a.url}
          controls
          class:list={["max-h-[480px] w-auto max-w-full rounded", i !== 0 && "hidden"]}
        />
      ) : (
        <img
          data-slide
          src={a.url}
          alt={a.name}
          class:list={["max-h-[480px] w-auto max-w-full rounded", i !== 0 && "hidden"]}
        />
      ),
    )}
    {assets.length > 1 && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Previous"
          class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-2 text-neutral-900 shadow transition-colors hover:bg-white"
        >
          <ChevronLeft class="h-5 w-5" />
        </button>
        <button
          type="button"
          data-next
          aria-label="Next"
          class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-2 text-neutral-900 shadow transition-colors hover:bg-white"
        >
          <ChevronRight class="h-5 w-5" />
        </button>
      </>
    )}
  </div>
  {assets.length > 1 && (
    <div class="flex items-center justify-center gap-1.5 border-t border-neutral-200 bg-white p-3">
      {assets.map((_, i) => (
        <button
          type="button"
          data-dot
          data-index={i}
          aria-label={`Slide ${i + 1}`}
          class:list={[
            "h-2 rounded-full transition-all",
            i === 0 ? "w-4 bg-accent" : "w-2 bg-neutral-300",
          ]}
        />
      ))}
    </div>
  )}
</div>

<script>
  for (const el of document.querySelectorAll("[data-carousel]")) {
    const slides = Array.from(el.querySelectorAll("[data-slide]"));
    const dots = Array.from(el.querySelectorAll("[data-dot]"));
    let current = 0;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("hidden", i !== current));
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle("bg-accent", active);
        d.classList.toggle("w-4", active);
        d.classList.toggle("bg-neutral-300", !active);
        d.classList.toggle("w-2", !active);
      });
    };
    el.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    el.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => show(i)));
  }
</script>