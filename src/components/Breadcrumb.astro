---
import { ChevronRight } from "lucide-astro";
interface Props {
  items: Array<{ label: string; href?: string }>;
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1 text-sm text-neutral-500">
  <a href="/" class="transition-colors hover:text-neutral-900">Home</a>
  {items.map((item) => (
    <Fragment>
      <ChevronRight class="h-3.5 w-3.5" />
      {item.href ? (
        <a href={item.href} class="transition-colors hover:text-neutral-900">
          {item.label}
        </a>
      ) : (
        <span class="text-neutral-700">{item.label}</span>
      )}
    </Fragment>
  ))}
</nav>