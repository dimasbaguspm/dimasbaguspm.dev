---
import type { Repo } from "../lib/posts";
const { repo } = Astro.props;
---
<li>
  <a
    href={repo.url}
    target="_blank"
    rel="noreferrer"
    class="flex h-full flex-col rounded-lg border border-neutral-200 p-4 transition-colors hover:border-neutral-300 hover:bg-neutral-50"
  >
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-medium text-accent">{repo.name}</h3>
      {repo.homepage && (
        <span class="truncate text-xs text-neutral-500">
          {repo.homepage.replace(/^https?:\/\//, "").replace(/\/$/, "")}
        </span>
      )}
    </div>
    <p class="mt-1 line-clamp-2 text-sm text-neutral-600">
      {repo.description ?? "No description"}
    </p>
    {repo.topics.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {repo.topics.slice(0, 4).map((t: string) => (
          <li class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">
            {t}
          </li>
        ))}
      </ul>
    )}
    <p class="mt-auto pt-2 text-xs text-neutral-500">
      {repo.language && <span class="mr-3">{repo.language}</span>}
      {repo.stars > 0 && <span class="mr-3">{repo.stars} stars</span>}
      {repo.forks > 0 && <span>{repo.forks} forks</span>}
    </p>
  </a>
</li>