---
import Base from "../layouts/Base.astro";

interface Props {
  isEdit: boolean;
  slug?: string;
  a: {
    slug?: string; title: string; description: string; pubDate: string;
    tags: string[]; draft: boolean; cover?: string; canonical?: string; author?: string; body: string;
  };
}
const { isEdit, slug, a } = Astro.props;
---
<Base title={isEdit ? `Edit — ${a.title}` : "New article"}>
  <section class="editor">
    <a href="/admin" class="back">← Back</a>
    <h1>{isEdit ? "Edit article" : "New article"}</h1>
    <form id="article-form" data-slug={slug ?? ""}>
      <label>Title<input name="title" value={a.title} required /></label>
      <label>Slug (optional)<input name="slug" value={a.slug ?? ""} placeholder="auto from title" /></label>
      <label>Description<textarea name="description" rows="2">{a.description}</textarea></label>
      <label>Publish date<input type="date" name="pubDate" value={a.pubDate} /></label>
      <label>Tags (comma separated)<input name="tags" value={a.tags.join(", ")} /></label>
      <label>Cover image URL<input name="cover" value={a.cover ?? ""} /></label>
      <label>Canonical URL<input name="canonical" value={a.canonical ?? ""} /></label>
      <label class="check"><input type="checkbox" name="draft" checked={a.draft} /> Draft</label>
      <label>Body (Markdown / MDX)
        <textarea name="body" rows="18" class="body">{a.body}</textarea>
      </label>
      <div class="actions">
        <button type="submit" class="btn primary">{isEdit ? "Save" : "Create"}</button>
        {isEdit && <button type="button" id="delete-btn" class="btn danger">Delete</button>}
        <span id="status" class="status"></span>
      </div>
    </form>
  </section>

  <script>
    const form = document.getElementById("article-form") as HTMLFormElement;
    const status = document.getElementById("status") as HTMLElement;
    const slug = (form as HTMLFormElement).dataset.slug || "";
    const isEdit = Boolean(slug);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        title: fd.get("title"),
        slug: fd.get("slug") || undefined,
        description: fd.get("description"),
        pubDate: fd.get("pubDate"),
        tags: String(fd.get("tags") || "").split(",").map((s) => s.trim()).filter(Boolean),
        draft: (fd.get("draft") as string) === "on",
        cover: fd.get("cover") || undefined,
        canonical: fd.get("canonical") || undefined,
        body: fd.get("body"),
      };
      status.textContent = "Saving…";
      const res = await fetch(isEdit ? `/api/articles/${slug}` : "/api/articles", {
        method: isEdit ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        status.textContent = "Saved ✓";
        setTimeout(() => (location.href = "/admin"), 600);
      } else {
        status.textContent = `Error ${res.status}`;
      }
    });

    document.getElementById("delete-btn")?.addEventListener("click", async () => {
      if (!confirm("Delete this article?")) return;
      const res = await fetch(`/api/articles/${slug}`, { method: "DELETE" });
      if (res.ok) location.href = "/admin";
    });
  </script>
</Base>

<style>
  .editor { max-width: 720px; margin: 0 auto; }
  .back { color: var(--muted); text-decoration: none; font-size: 14px; }
  form { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1rem; }
  label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 14px; }
  label.check { flex-direction: row; align-items: center; gap: 0.5rem; }
  input, textarea { font: inherit; padding: 0.5rem; border: 1px solid #d0d5dd; border-radius: 8px; }
  textarea.body { font-family: ui-monospace, monospace; }
  .actions { display: flex; gap: 0.8rem; align-items: center; }
  .btn { padding: 0.5rem 1rem; border: 1px solid #d0d5dd; border-radius: 8px; cursor: pointer; }
  .primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .danger { background: #b91c1c; color: #fff; border-color: #b91c1c; }
  .status { color: var(--muted); font-size: 14px; }
</style>
