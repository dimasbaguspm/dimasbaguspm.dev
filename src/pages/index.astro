---
import Base from "../layouts/Base.astro";
import { getProfile, listPosts } from "../lib/posts";
export const prerender = false;
const profile = await getProfile();
const posts = await listPosts();
---
<Base title={profile.name} description={profile.bio ?? undefined}>
  <section class="py-12">
    <img
      src={profile.avatar}
      width={96}
      height={96}
      alt={profile.name}
      class="rounded-full border border-neutral-200"
    />
    <h1 class="mt-5 text-4xl font-bold tracking-tight">{profile.name}</h1>
    <p class="mt-3 max-w-xl text-neutral-600">{profile.bio}</p>
    {profile.blog && (
      <a href={profile.blog} class="mt-4 inline-block font-medium text-accent hover:underline">
        {profile.blog.replace(/^https?:\/\//, "")} ↗
      </a>
    )}
  </section>

  <section>
    <h2 class="text-xl font-semibold">Latest articles</h2>
    <ul class="mt-4">
      {posts.slice(0, 5).map((a) => (
        <li class="flex items-baseline gap-3 py-2">
          <a href={`/posts/${a.slug}`} class="hover:underline">{a.title}</a>
          {a.pubDate && (
            <time datetime={a.pubDate} class="text-sm text-neutral-500">{a.pubDate}</time>
          )}
        </li>
      ))}
    </ul>
    <a href="/posts" class="mt-3 inline-block font-medium text-accent hover:underline">
      All articles →
    </a>
  </section>
</Base>
