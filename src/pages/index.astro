---
import Base from "../layouts/Base.astro";
import { formatDate, getProfile, listPosts, listProjects } from "../lib/posts";
export const prerender = false;
const [profile, posts, projects] = await Promise.all([
  getProfile(),
  listPosts(),
  listProjects(6),
]);
---
<Base title={profile.name} description={profile.bio ?? undefined}>
  <section class="py-10 sm:py-12">
    <img
      src={profile.avatar}
      width={96}
      height={96}
      alt={profile.name}
      class="h-24 w-24 rounded-full border border-neutral-200"
    />
    <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-3 max-w-xl text-neutral-600">{profile.bio}</p>
    {profile.blog && (
      <a href={profile.blog} class="mt-4 inline-block font-medium text-accent hover:underline">
        {profile.blog.replace(/^https?:\/\//, "")}
      </a>
    )}
  </section>

  <section>
    <h2 class="text-xl font-semibold">Latest articles</h2>
    <ul class="mt-4">
      {posts.slice(0, 5).map((a) => (
        <li class="flex flex-col py-2 sm:flex-row sm:items-baseline sm:gap-3">
          <a href={`/posts/${a.slug}`} class="hover:underline">{a.title}</a>
          {a.pubDate && (
            <time datetime={a.pubDate} class="text-sm text-neutral-500">
              {formatDate(a.pubDate)}
            </time>
          )}
        </li>
      ))}
    </ul>
    <a href="/posts" class="mt-3 inline-block font-medium text-accent hover:underline">
      All articles
    </a>
  </section>

  <section id="projects" class="mt-12">
    <h2 class="text-xl font-semibold">Projects</h2>
    <p class="mt-1 text-sm text-neutral-500">Open source, straight from GitHub</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {projects.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noreferrer"
            class="block rounded-lg border border-neutral-200 p-4 transition-colors hover:border-neutral-300 hover:bg-neutral-50"
          >
            <h3 class="font-medium text-accent">{p.name}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-neutral-600">
              {p.description ?? "No description"}
            </p>
            <p class="mt-2 text-xs text-neutral-500">
              {p.language && <span class="mr-3">{p.language}</span>}
              {p.stars > 0 && <span>{p.stars} stars</span>}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>