---
import Base from "../layouts/Base.astro";
const posts = Object.values(await import.meta.glob("./posts/*.md", { eager: true })) as any[];
const articles = posts
  .filter((p) => !p.frontmatter.draft)
  .sort((a, b) => (b.frontmatter.pubDate ?? "").localeCompare(a.frontmatter.pubDate ?? ""))
  .slice(0, 5);
---
<Base title="Dimas Bagus Putra Mahottama">
  <section class="hero">
    <h1>Hey, I'm Dimas.</h1>
    <p>I write about engineering, systems, and the things I build. Minimal, fast, and friendly to search engines.</p>
  </section>

  <section>
    <h2>Latest articles</h2>
    <ul class="posts">
      {articles.map((a) => (
        <li>
          <a href={a.url}>{a.frontmatter.title}</a>
          {a.frontmatter.pubDate && (
            <time datetime={a.frontmatter.pubDate}>{a.frontmatter.pubDate}</time>
          )}
        </li>
      ))}
    </ul>
    <a class="more" href="/posts">All articles →</a>
  </section>
</Base>

<style>
  .hero h1 { font-size: 2.2rem; margin-bottom: 0.2rem; }
  .posts { list-style: none; padding: 0; }
  .posts li { margin: 0.6rem 0; display: flex; gap: 0.8rem; align-items: baseline; }
  .posts time { color: var(--muted); font-size: 14px; }
  .more { display: inline-block; margin-top: 0.5rem; }
</style>
