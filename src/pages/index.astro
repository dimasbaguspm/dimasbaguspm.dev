---
import Base from "../layouts/Base.astro";
import { listPosts } from "../lib/posts";
export const prerender = false;
const posts = await listPosts();
---
<Base title="Dimas Bagus Putra Mahottama">
  <section class="hero">
    <h1>Hey, I'm Dimas.</h1>
    <p>I write about engineering, systems, and the things I build. Minimal, fast, and friendly to search engines.</p>
  </section>

  <section>
    <h2>Latest articles</h2>
    <ul class="posts">
      {posts.slice(0, 5).map((a) => (
        <li>
          <a href={`/posts/${a.slug}`}>{a.title}</a>
          {a.pubDate && <time datetime={a.pubDate}>{a.pubDate}</time>}
        </li>
      ))}
    </ul>
    <a class="more" href="/posts">All articles →</a>
  </section>
</Base>

<style>
  .hero h1 { font-size: 2.2rem; margin-bottom: 0.2rem; }
  .posts { list-style: none; padding: 0; }
  .posts li { margin: 0.6rem 0; display: flex; gap: 0.8rem; align-items: baseline; }
  .posts time { color: var(--muted); font-size: 14px; }
  .more { display: inline-block; margin-top: 0.5rem; }
</style>
