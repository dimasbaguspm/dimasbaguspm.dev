---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { formatDate, getProfile, listPosts, listProjects } from "../lib/posts";
export const prerender = false;
const [profile, posts, projects] = await Promise.all([
  getProfile(),
  listPosts(),
  listProjects(6),
]);
---
<Base title={profile.name} description={profile.bio ?? undefined}>
  <section class="py-10 sm:py-12">
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
      <img
        src={profile.avatar}
        width={96}
        height={96}
        alt={profile.name}
        class="h-20 w-20 shrink-0 rounded-full border border-neutral-200 sm:h-24 sm:w-24"
      />
      <div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{profile.name}</h1>
        <p class="mt-1 max-w-xl text-neutral-600">{profile.bio}</p>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold">Latest articles</h2>
    <ul class="mt-4">
      {posts.slice(0, 5).map((a) => (
        <li class="flex flex-col py-2 sm:flex-row sm:items-baseline sm:gap-3">
          <a href={`/posts/${a.slug}`} class="hover:underline">{a.title}</a>
          {a.pubDate && (
            <time datetime={a.pubDate} class="text-sm text-neutral-500">
              {formatDate(a.pubDate)}
            </time>
          )}
        </li>
      ))}
    </ul>
    <a href="/posts" class="mt-3 inline-block font-medium text-accent hover:underline">
      All articles
    </a>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">Projects</h2>
    <p class="mt-1 text-sm text-neutral-500">Open source, straight from GitHub</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {projects.map((repo) => <ProjectCard repo={repo} />)}
    </ul>
    <a href="/projects" class="mt-4 inline-block font-medium text-accent hover:underline">
      All projects
    </a>
  </section>
</Base>