---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { formatDate, getProfile, listPosts } from "../lib/posts";
import { listProjectsByTag } from "../lib/projects";
export const prerender = false;
const [profile, posts, projects] = await Promise.all([
  getProfile(),
  listPosts(),
  listProjectsByTag("personal-project"),
]);
const ogImage = new URL(
  "/og/home.png",
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base title={profile.name} description={profile.bio ?? undefined} image={ogImage} hideTopbar>
  <section class="flex flex-col items-center py-4 text-center">
    <img
      src={profile.avatar}
      width={128}
      height={128}
      alt={profile.name}
      class="h-32 w-32 rounded-full border border-neutral-200 sm:h-36 sm:w-36"
    />
    <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-3 max-w-xl text-neutral-600">{profile.bio}</p>
  </section>

  <section>
    <h2 class="text-xl font-semibold">Latest articles</h2>
    <ul class="mt-4">
      {posts.slice(0, 5).map((a) => (
        <li class="flex flex-col py-2 sm:flex-row sm:items-baseline sm:gap-3">
          <a href={`/posts/${a.slug}`} class="hover:underline">{a.title}</a>
          {a.pubDate && (
            <time datetime={a.pubDate} class="text-sm text-neutral-500">
              {formatDate(a.pubDate)}
            </time>
          )}
        </li>
      ))}
    </ul>
    <a href="/posts" class="mt-3 inline-block font-medium text-accent hover:underline">
      All articles
    </a>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">Projects</h2>
    <p class="mt-1 text-sm text-neutral-500">Personal projects, straight from GitHub</p>
    {projects.length > 0 ? (
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {projects.slice(0, 6).map((repo) => <ProjectCard repo={repo} />)}
      </ul>
    ) : (
      <p class="mt-4 text-sm text-neutral-500">
        Nothing tagged yet — add the <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs">personal-project</code> topic to a repo.
      </p>
    )}
    <a href="/projects" class="mt-4 inline-block font-medium text-accent hover:underline">
      All projects
    </a>
  </section>
</Base>