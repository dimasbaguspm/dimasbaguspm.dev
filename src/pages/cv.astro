---
import Base from "../layouts/Base.astro";
import { getProfile, readDocument, renderMarkdown } from "../lib/posts";
export const prerender = false;
const [profile, doc] = await Promise.all([
  getProfile(),
  readDocument("content/cv.md"),
]);
const title = (doc?.fm.title as string) ?? "CV";
const html = renderMarkdown(doc?.body ?? "_CV coming soon — content lives in `content/cv.md`._");
---
<Base title={`${title} — ${profile.name}`}>
  <article class="py-8">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <img
        src={profile.avatar}
        width={64}
        height={64}
        alt={profile.name}
        class="h-16 w-16 rounded-full border border-neutral-200"
      />
      <div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{profile.name}</h1>
        {profile.bio && <p class="mt-1 text-neutral-600">{profile.bio}</p>}
      </div>
    </header>
    <div class="prose-simple mt-8" set:html={html} />
  </article>
</Base>