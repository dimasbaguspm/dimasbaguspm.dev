---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Pill from "../../components/Pill.astro";
import { getProfile } from "../../lib/posts";
import { listProjectsByTag } from "../../lib/projects";
export const prerender = false;
const [profile, repos] = await Promise.all([
  getProfile(),
  listProjectsByTag("personal-project"),
]);
const ogImage = new URL(
  "/og/projects.png",
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base
  title={`Projects — ${profile.name}`}
  description="Personal projects, tagged personal-project on GitHub."
  image={ogImage}
>
  <div class="py-8">
    <Breadcrumb items={[{ label: "Projects" }]} />
    <h1 class="mt-4 pb-8 text-2xl font-bold tracking-tight sm:text-3xl">Projects</h1>
    <p class="flex items-center gap-1.5 pb-4 text-sm text-neutral-500">
      Repos tagged <Pill label="personal-project" /> on GitHub.
    </p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {repos.map((repo) => <ProjectCard repo={repo} />)}
    </ul>
    {repos.length === 0 && (
      <p class="text-neutral-500">
        No tagged projects yet — add the <Pill label="personal-project" /> topic to a repo.
      </p>
    )}
  </div>
</Base>