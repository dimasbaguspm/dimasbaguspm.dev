---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Tabs from "../../components/Tabs.astro";
import PreviewCarousel from "../../components/PreviewCarousel.astro";
import NotFound from "../../components/NotFound.astro";
import { getProfile, renderMarkdown } from "../../lib/posts";
import {
  getProject,
  getEngineeringSpec,
  listPreviewAssets,
} from "../../lib/projects";
export const prerender = false;
const { slug } = Astro.params;
const [profile, repo] = await Promise.all([
  getProfile(),
  getProject(slug ?? ""),
]);
if (!repo) return Astro.redirect("/projects", 404);
const [preview, spec] = await Promise.all([
  listPreviewAssets(repo.name),
  getEngineeringSpec(repo.name),
]);
const ogImage = new URL(
  `/og/${repo.name.toLowerCase()}.png`,
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base
  title={`${repo.name} — ${profile.name}`}
  description={repo.description ?? undefined}
  image={ogImage}
>
  <article class="py-4">
    <Breadcrumb
      items={[{ label: "Projects", href: "/projects" }, { label: repo.name }]}
    />
    <header class="mt-4">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{repo.name}</h1>
      <p class="mt-2 text-neutral-600">{repo.description}</p>
      <p class="mt-3 flex flex-wrap items-center gap-3 text-xs text-neutral-500">
        {repo.language && <span>{repo.language}</span>}
        {repo.stars > 0 && <span>{repo.stars} stars</span>}
        {repo.forks > 0 && <span>{repo.forks} forks</span>}
        <a href={repo.url} target="_blank" rel="noreferrer" class="font-medium text-accent hover:underline">
          GitHub
        </a>
        {repo.homepage && (
          <a href={repo.homepage} target="_blank" rel="noreferrer" class="font-medium text-accent hover:underline">
            Homepage
          </a>
        )}
      </p>
    </header>

    <div class="mt-6">
      <Tabs labelA="Preview" labelB="Engineering Spec">
        <div slot="a">
          {preview.length > 0 ? (
            <PreviewCarousel assets={preview} />
          ) : (
            <NotFound message="No preview assets — add docs/preview/*" />
          )}
        </div>
        <div slot="b">
          {spec ? (
            <div class="prose-simple" set:html={renderMarkdown(spec)} />
          ) : (
            <NotFound message="No engineering spec — add docs/ENGINEERING_SPEC.md" />
          )}
        </div>
      </Tabs>
    </div>
  </article>
</Base>