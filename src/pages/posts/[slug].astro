---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Pill from "../../components/Pill.astro";
import { formatDate, getProfile, readPost, renderMarkdown } from "../../lib/posts";
export const prerender = false;
const { slug } = Astro.params;
const post = slug ? await readPost(slug) : null;
if (!post) return Astro.redirect("/posts", 404);
const html = renderMarkdown(post.body);
const profile = await getProfile();
const ogImage = new URL(
  `/og/${post.slug}.png`,
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base title={post.title} description={post.description} type="article" image={ogImage}>
  <article class="py-8">
    <Breadcrumb items={[{ label: "Articles", href: "/posts" }, { label: post.title }]} />
    <header class="mt-4">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{post.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-neutral-500">
        <img src={profile.avatar} alt={profile.name} width="28" height="28" class="h-7 w-7 rounded-full" />
        <span>{profile.name}</span>
        {post.pubDate && <time datetime={post.pubDate}>{formatDate(post.pubDate)}</time>}
      </div>
      {post.tags.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {post.tags.map((t) => (
            <li><Pill label={`#${t}`} /></li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose-simple mt-8" set:html={html} />
  </article>
</Base>