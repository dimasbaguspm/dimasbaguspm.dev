---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Pill from "../../components/Pill.astro";
import ShareButton from "../../components/ShareButton.astro";
import { estimateReadingTime, formatDate, getPostHistory, getProfile, readPost, renderMarkdown } from "../../lib/posts";
export const prerender = false;
const { slug } = Astro.params;
const post = slug ? await readPost(slug) : null;
if (!post) return Astro.redirect("/posts", 404);
const html = renderMarkdown(post.body);
const [profile, history] = await Promise.all([getProfile(), getPostHistory(slug!)]);
const lastUpdated = history[0]?.date;
const showUpdated = lastUpdated && lastUpdated.slice(0, 10) !== post.pubDate?.slice(0, 10);
const readingTime = estimateReadingTime(post.body);
const ogImage = new URL(
  `/og/${post.slug}.png`,
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base title={post.title} description={post.description} type="article" image={ogImage}>
  <article class="py-4">
    <Breadcrumb items={[{ label: "Articles", href: "/posts" }, { label: post.title }]} />
    <header class="mt-4">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{post.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-neutral-500">
        <img src={profile.avatar} alt={profile.name} width="28" height="28" class="h-7 w-7 rounded-full border border-neutral-200" />
        <span>{profile.name}</span>
        <span class="h-1 w-1 rounded-full bg-neutral-300"></span>
        {post.pubDate && <time datetime={post.pubDate}>{formatDate(post.pubDate)}</time>}
        <span class="h-1 w-1 rounded-full bg-neutral-300"></span>
        <span>{readingTime}</span>
        {showUpdated && lastUpdated && (
          <><span class="h-1 w-1 rounded-full bg-neutral-300"></span><span>updated {formatDate(lastUpdated)}</span></>
        )}
      </div>
      <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
        {post.tags.length > 0 ? (
          <ul class="flex flex-wrap gap-1.5">
            {post.tags.map((t) => (
              <li><Pill label={`#${t}`} /></li>
            ))}
          </ul>
        ) : (
          <span></span>
        )}
        <ShareButton title={post.title} text={post.description} />
      </div>
    </header>
    <div class="prose-simple mt-8" set:html={html} />
    {history.length > 0 && (
      <section class="mt-8 border-t border-neutral-200 pt-4">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-neutral-500">History</h2>
        <p class="mt-1 text-xs text-neutral-500">{history.length} version{history.length > 1 ? "s" : ""} · latest {formatDate(history[0].date)}</p>
        <ol class="mt-2 space-y-1.5">
          {history.map((v, i) => (
            <li class="flex items-baseline gap-2 text-xs">
              <a href={v.url} target="_blank" rel="noreferrer" class="font-mono text-[11px] text-accent hover:underline">{v.shortSha}</a>
              <span class="flex-1 truncate text-neutral-700">{v.message}</span>
              <time datetime={v.date} class="shrink-0 text-[11px] text-neutral-500">{formatDate(v.date)}</time>
              {i === 0 && <span class="rounded bg-neutral-900 px-1.5 py-0.5 text-[10px] leading-none text-white">latest</span>}
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Base>