---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatDate, getProfile, listPosts } from "../../lib/posts";
export const prerender = false;
const [profile, posts] = await Promise.all([getProfile(), listPosts()]);
const ogImage = new URL(
  "/og/posts.png",
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
---
<Base
  title={`Articles — ${profile.name}`}
  description="Articles and notes."
  image={ogImage}
>
  <Breadcrumb items={[{ label: "Articles" }]} />
  <h1 class="py-8 text-3xl font-bold tracking-tight">Articles</h1>
  <ul>
    {posts.map((p) => (
      <li class="flex flex-col py-2 sm:flex-row sm:items-baseline sm:gap-3">
        <a href={`/posts/${p.slug}`} class="hover:underline">{p.title}</a>
        {p.pubDate && (
          <time datetime={p.pubDate} class="text-sm text-neutral-500">
            {formatDate(p.pubDate)}
          </time>
        )}
      </li>
    ))}
  </ul>
</Base>