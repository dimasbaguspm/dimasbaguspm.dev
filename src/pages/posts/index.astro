---
import Base from "../../layouts/Base.astro";
import { getProfile, listPosts } from "../../lib/posts";
export const prerender = false;
const [profile, posts] = await Promise.all([getProfile(), listPosts()]);
---
<Base title={`Articles — ${profile.name}`}>
  <h1 class="py-8 text-3xl font-bold tracking-tight">Articles</h1>
  <ul>
    {posts.map((p) => (
      <li class="flex items-baseline gap-3 py-2">
        <a href={`/posts/${p.slug}`} class="hover:underline">{p.title}</a>
        {p.pubDate && (
          <time datetime={p.pubDate} class="text-sm text-neutral-500">{p.pubDate}</time>
        )}
      </li>
    ))}
  </ul>
</Base>