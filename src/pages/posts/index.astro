---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { estimateReadingTime, formatDate, getProfile, listPosts } from "../../lib/posts";
export const prerender = false;
const [profile, posts] = await Promise.all([getProfile(), listPosts()]);
const ogImage = new URL(
  "/og/posts.png",
  Astro.site ?? "https://dimasbaguspm.dev",
).toString();
const allTags = [...new Set(posts.flatMap((p) => p.tags))].sort();
---
<Base title={`Articles — ${profile.name}`} description="Articles and notes." image={ogImage}>
  <div class="py-4">
    <Breadcrumb items={[{ label: "Articles" }]} />
    <header class="mt-4">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Articles ({posts.length})</h1>
      <p class="mt-1 text-sm text-neutral-500">
        {posts.length} article{posts.length !== 1 ? "s" : ""} · {allTags.length} tag{allTags.length !== 1 ? "s" : ""}
      </p>
      {allTags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5" data-tag-filter>
          <button
            type="button"
            data-tag="all"
            class="rounded-full bg-neutral-900 px-3 py-1 text-xs font-medium text-white"
          >
            All
          </button>
          {allTags.map((t) => (
            <button
              type="button"
              data-tag={t}
              class="rounded-full border border-neutral-200 bg-white px-3 py-1 text-xs text-neutral-700 hover:bg-neutral-50"
            >
              #{t}
            </button>
          ))}
        </div>
      )}
    </header>

    <ul class="mt-6 space-y-3" data-post-list>
      {posts.map((p) => (
        <li
          data-tags={p.tags.join(",")}
          class="rounded-lg border border-neutral-200 p-4 transition-colors hover:border-neutral-300 hover:bg-neutral-50"
        >
          <a href={`/posts/${p.slug}`} class="font-medium hover:underline">{p.title}</a>
          {p.description && (
            <p class="mt-1 line-clamp-2 text-sm text-neutral-600">{p.description}</p>
          )}
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-neutral-500">
            {p.pubDate && <time datetime={p.pubDate}>{formatDate(p.pubDate)}</time>}
            <span class="h-1 w-1 rounded-full bg-neutral-300"></span>
            <span>{estimateReadingTime(p.body)}</span>
            {p.tags.length > 0 && (
              <>
                <span class="h-1 w-1 rounded-full bg-neutral-300"></span>
                <span class="flex flex-wrap gap-1">
                  {p.tags.map((t) => (
                    <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] text-neutral-600">#{t}</span>
                  ))}
                </span>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div data-sentinel class="h-4"></div>
    <p data-empty class="hidden rounded-lg border border-dashed border-neutral-300 px-6 py-8 text-center text-sm text-neutral-500">
      No articles for this tag.
    </p>
  </div>
</Base>

<script>
  const PAGE_SIZE = 6;
  const filter = document.querySelector("[data-tag-filter]") as HTMLElement | null;
  const list = document.querySelector("[data-post-list]") as HTMLElement | null;
  const sentinel = document.querySelector("[data-sentinel]") as HTMLElement | null;
  const empty = document.querySelector("[data-empty]") as HTMLElement | null;
  if (filter && list && sentinel) {
    const btns = Array.from(filter.querySelectorAll("[data-tag]")) as HTMLButtonElement[];
    const items = Array.from(list.children) as HTMLElement[];
    let activeTag = "all";
    let visibleCount = PAGE_SIZE;

    const getFiltered = () =>
      items.filter((li) => {
        const tags = (li.dataset.tags || "").split(",").filter(Boolean);
        return activeTag === "all" || tags.includes(activeTag);
      });

    const render = () => {
      const filtered = getFiltered();
      items.forEach((li) => li.classList.add("hidden"));
      filtered.slice(0, visibleCount).forEach((li) => li.classList.remove("hidden"));
      const hasMore = filtered.length > visibleCount;
      sentinel.classList.toggle("hidden", !hasMore);
      empty?.classList.toggle("hidden", filtered.length !== 0);
      btns.forEach((b) => {
        const active = b.dataset.tag === activeTag;
        b.classList.toggle("bg-neutral-900", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border-neutral-900", active);
        b.classList.toggle("bg-white", !active);
        b.classList.toggle("text-neutral-700", !active);
        b.classList.toggle("border-neutral-200", !active);
      });
    };

    btns.forEach((b) =>
      b.addEventListener("click", () => {
        activeTag = b.dataset.tag || "all";
        visibleCount = PAGE_SIZE;
        render();
      }),
    );

    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          visibleCount += PAGE_SIZE;
          render();
        }
      },
      { rootMargin: "200px" },
    );
    io.observe(sentinel);
    render();
  }
</script>
