---
import Base from "../../layouts/Base.astro";
import { listPosts } from "../../lib/posts";
export const prerender = false;
const posts = await listPosts();
---
<Base title="Articles — dimasbaguspm.dev">
  <h1>Articles</h1>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.slug}`}>{p.title}</a>
        {p.pubDate && <time datetime={p.pubDate}>{p.pubDate}</time>}
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li { margin: 0.6rem 0; display: flex; gap: 0.8rem; align-items: baseline; }
  .posts time { color: var(--muted); font-size: 14px; }
</style>
