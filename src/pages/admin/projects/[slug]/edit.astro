---
import ProjectForm from "../../../../components/ProjectForm.astro";
import { readSession } from "../../../../lib/session";
import { getProject } from "../../../../lib/projects";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie") ?? undefined;
const session = await readSession(cookie);
if (!session) return Astro.redirect("/admin/login", 302);

const slug = Astro.params.slug!;
const project = getProject(slug);
if (!project) return Astro.redirect("/admin/projects", 302);
---

<ProjectForm isEdit={true} p={project} />
