---
import Base from "../../layouts/Base.astro";
import { readSession } from "../../lib/session";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie") ?? undefined;
const session = await readSession(cookie);
if (!session) return Astro.redirect("/admin/login", 302);
---

<Base title="Assets · Admin" description="Manage uploaded assets">
  <main class="admin">
    <nav class="crumbs"><a href="/admin">Admin</a> / <span>Assets</span></nav>
    <h1>Assets</h1>

    <section class="card">
      <h2>Upload</h2>
      <form id="upload" enctype="multipart/form-data">
        <input type="file" name="file" required />
        <button type="submit">Upload</button>
      </form>
      <p id="msg" class="msg"></p>
    </section>

    <section class="card">
      <h2>Library</h2>
      <ul id="list" class="assets"></ul>
      <p id="empty" class="muted">No assets yet.</p>
    </section>
  </main>

  <script>
    const list = document.getElementById("list") as HTMLUListElement;
    const msg = document.getElementById("msg") as HTMLParagraphElement;
    const empty = document.getElementById("empty") as HTMLParagraphElement;

    async function load() {
      const res = await fetch("/api/assets");
      const items = (await res.json()) as { name: string; url: string; size: number }[];
      list.innerHTML = "";
      empty.style.display = items.length ? "none" : "block";
      for (const it of items) {
        const li = document.createElement("li");
        li.innerHTML = `
          <a href="${it.url}" target="_blank" rel="noopener">${it.name}</a>
          <span class="muted">(${(it.size / 1024).toFixed(1)} KB)</span>
          <button data-copy="${it.url}">Copy URL</button>
          <button data-del="${it.name}">Delete</button>`;
        list.appendChild(li);
      }
    }

    document.getElementById("upload")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const fd = new FormData(form);
      const res = await fetch("/api/assets", { method: "POST", body: fd });
      const data = await res.json().catch(() => ({}));
      msg.textContent = res.ok ? `Uploaded ${data.name}` : `Error: ${data.message || res.status}`;
      if (res.ok) { form.reset(); load(); }
    });

    list.addEventListener("click", async (e) => {
      const t = e.target as HTMLElement;
      if (t.dataset.copy) {
        await navigator.clipboard.writeText(t.dataset.copy);
        msg.textContent = "URL copied";
      } else if (t.dataset.del) {
        const res = await fetch(`/api/assets/${encodeURIComponent(t.dataset.del)}`, { method: "DELETE" });
        if (res.ok) load();
      }
    });

    load();
  </script>
</Base>

<style>
  .admin { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
  .crumbs a { color: inherit; }
  .card { border: 1px solid var(--border, #333); border-radius: 10px; padding: 1rem 1.25rem; margin: 1rem 0; }
  .assets { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .assets li { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .muted { color: #888; font-size: 0.85rem; }
  .msg { min-height: 1.2rem; color: #6cf; }
  button { cursor: pointer; border: 1px solid #444; background: #1a1a1a; color: inherit; border-radius: 6px; padding: 0.3rem 0.6rem; }
  button:hover { border-color: #888; }
</style>
