---
import Base from "../../layouts/Base.astro";
import { readSession } from "../../lib/session";
import { getCollection } from "astro:content";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie") ?? undefined;
const session = await readSession(cookie);
if (!session) return Astro.redirect("/admin/login", 302);

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---
<Base title="Admin — dimasbaguspm.dev">
  <section class="admin">
    <header class="top">
      <h1>Admin</h1>
      <div class="who">
        <span>{session?.email ?? session?.sub}</span>
        <a class="btn" href="/admin/logout">Log out</a>
      </div>
    </header>

    <a class="btn primary" href="/admin/articles/new">+ New article</a>
    <a class="btn" href="/admin/assets">Assets</a>
    <a class="btn" href="/admin/projects">Projects</a>

    <h2>Articles</h2>
    {articles.length === 0 ? (
      <p class="empty">No articles yet.</p>
    ) : (
      <ul class="list">
        {articles.map((a) => (
          <li>
            <a href={`/admin/articles/${a.slug}/edit`} class="title">{a.data.title}</a>
            <span class="meta">
              {a.data.pubDate.toISOString().slice(0, 10)}
              {a.data.draft && <em class="draft"> · draft</em>}
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .admin { max-width: 720px; margin: 0 auto; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .who { display: flex; gap: 0.8rem; align-items: center; color: var(--muted); font-size: 14px; }
  .btn { display: inline-block; padding: 0.45rem 0.9rem; border: 1px solid #d0d5dd; border-radius: 8px; text-decoration: none; }
  .primary { background: var(--accent); color: #fff; border-color: var(--accent); margin: 1rem 0; }
  .list { list-style: none; padding: 0; }
  .list li { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #eee; }
  .title { font-weight: 600; text-decoration: none; }
  .meta { color: var(--muted); font-size: 14px; }
  .draft { color: #b45309; }
</style>
