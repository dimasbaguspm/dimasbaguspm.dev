---
import Base from "../../layouts/Base.astro";
import { readSession } from "../../lib/session";

export const prerender = false;

const secret = import.meta.env.OIDC_CLIENT_SECRET;
const cookie = Astro.request.headers.get("cookie") ?? undefined;
const session = secret ? await readSession(secret, cookie) : null;

if (!session) {
  return Astro.redirect("/admin/login", 302);
}
---
<Base title="Admin — dimasbaguspm.dev">
  <section class="admin">
    <h1>Admin</h1>
    <p class="who">Signed in as <strong>{session?.email ?? session?.sub}</strong></p>
    <p>The writing dashboard is coming in the next phase. For now you're authenticated.</p>
    <p class="actions">
      <a class="btn" href="/admin/logout">Log out</a>
    </p>
  </section>
</Base>

<style>
  .admin h1 { font-size: 1.8rem; }
  .who { color: var(--muted); }
  .btn { display: inline-block; padding: 0.5rem 1rem; border: 1px solid var(--edge, #d0d5dd); border-radius: 8px; }
</style>
