---
import { getProfile } from "../lib/posts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  image?: string;
  hideTopbar?: boolean;
}
const {
  title,
  description = "Personal site of Dimas Bagus Prayogo Mukti — engineering, notes, and projects.",
  canonical,
  type = "website",
  image,
  hideTopbar = false,
} = Astro.props;
const site = Astro.site?.toString() ?? "https://dimasbaguspm.dev";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).toString();
const profile = await getProfile();
const ogImage = image ?? profile.avatar;
const umamiSrc = process.env.UMAMI_SRC;
const umamiId = process.env.UMAMI_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={profile.avatar} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={profile.name} />
    {umamiSrc && umamiId && (
      <script is:inline async src={umamiSrc} data-website-id={umamiId} />
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === "article" ? "Article" : "WebSite",
      name: title,
      headline: title,
      description,
      url: canonicalUrl,
      image: ogImage,
      author: { "@type": "Person", name: profile.name, url: profile.blog },
    })} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-neutral-900 antialiased">
    {!hideTopbar && <Header site={site} />}
    <main class="mx-auto w-full max-w-3xl flex-1 px-4">
      <slot />
    </main>
    <Footer name={profile.name} />
  </body>
</html>