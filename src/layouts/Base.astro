---
import { getProfile } from "../lib/posts";
import { Globe, Mail } from "lucide-astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  image?: string;
}
const {
  title,
  description = "Personal site of Dimas Bagus Prayogo Mukti — engineering, notes, and projects.",
  canonical,
  type = "website",
  image,
} = Astro.props;
const site = Astro.site?.toString() ?? "https://dimasbaguspm.dev";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).toString();
const profile = await getProfile();
const ogImage = image ?? profile.avatar;
const umamiSrc = process.env.UMAMI_SRC;
const umamiId = process.env.UMAMI_ID;
const xIcon =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>';
const githubIcon =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={profile.avatar} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={profile.name} />
    {umamiSrc && umamiId && (
      <script is:inline async src={umamiSrc} data-website-id={umamiId} />
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === "article" ? "Article" : "WebSite",
      name: title,
      headline: title,
      description,
      url: canonicalUrl,
      image: ogImage,
      author: { "@type": "Person", name: profile.name, url: profile.blog },
    })} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-neutral-900 antialiased">
    <header class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-6">
      <a href="/" class="font-semibold">{new URL(site).host}</a>
      <nav class="flex flex-wrap items-center gap-4 text-sm text-neutral-500">
        <a href="/posts" class="transition-colors hover:text-neutral-900">Articles</a>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-3xl px-4 py-12">
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200 pt-6">
        <p class="text-sm text-neutral-500">© {new Date().getFullYear()} {profile.name}</p>
        <nav class="flex items-center gap-4">
          <a href="mailto:me@dimasbaguspm.dev" aria-label="Email" class="text-neutral-500 transition-colors hover:text-neutral-900"><Mail class="h-5 w-5" /></a>
          <a href="https://dimasbaguspm.dev" aria-label="Website" target="_blank" rel="noreferrer" class="text-neutral-500 transition-colors hover:text-neutral-900"><Globe class="h-5 w-5" /></a>
          <a href="https://x.com/dimasbaguspm" aria-label="X (Twitter)" target="_blank" rel="noreferrer" class="text-neutral-500 transition-colors hover:text-neutral-900" set:html={xIcon} />
          <a href="https://github.com/dimasbaguspm" aria-label="GitHub" target="_blank" rel="noreferrer" class="text-neutral-500 transition-colors hover:text-neutral-900" set:html={githubIcon} />
        </nav>
      </div>
    </footer>
  </body>
</html>