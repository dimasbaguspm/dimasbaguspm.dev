---
import { getProfile } from "../lib/posts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  image?: string;
  hideTopbar?: boolean;
}
const {
  title,
  description = "Personal site of Dimas Bagus Prayogo Mukti — engineering, notes, and projects.",
  canonical,
  type = "website",
  image,
  hideTopbar = false,
} = Astro.props;
const site = Astro.site?.toString() ?? "https://dimasbaguspm.dev";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).toString();
const profile = await getProfile();
const ogImage = image ?? profile.avatar;
const umamiSrc = process.env.UMAMI_SRC;
const umamiId = process.env.UMAMI_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={profile.avatar} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={profile.name} />
    {umamiSrc && umamiId && (
      <script is:inline async src={umamiSrc} data-website-id={umamiId} />
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === "article" ? "Article" : "WebSite",
      name: title,
      headline: title,
      description,
      url: canonicalUrl,
      image: ogImage,
      author: { "@type": "Person", name: profile.name, url: profile.blog },
    })} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-neutral-900 antialiased">
    {!hideTopbar && <Header site={site} />}
    <main class="mx-auto w-full max-w-3xl flex-1 px-4">
      <slot />
    </main>
    <Footer name={profile.name} />
    <script is:inline type="module">
      if (document.querySelector('.mermaid')) {
        import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(async ({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
          await mermaid.run({ querySelector: '.mermaid' });
          // ponytail: toolbar uses native Fullscreen/Canvas — no deps, SVG scale via transform
          document.querySelectorAll('.mermaid-wrap').forEach((wrap) => {
            const mEl = wrap.querySelector('.mermaid');
            const svg = mEl?.querySelector('svg');
            if (!svg) return;
            let scale = 1;
            const apply = () => { svg.style.transform = `scale(${scale})`; svg.style.transformOrigin = 'top left'; };
            const bar = document.createElement('div');
            bar.className = 'mermaid-toolbar';
            bar.innerHTML = '<button type="button" title="Zoom out" aria-label="Zoom out" data-a="out">−</button><button type="button" title="Zoom in" aria-label="Zoom in" data-a="in">+</button><button type="button" title="Reset" aria-label="Reset" data-a="reset">⊡</button><button type="button" title="Fullscreen" aria-label="Fullscreen" data-a="fs">⛶</button><button type="button" title="Export PNG" aria-label="Export PNG" data-a="png">↓</button>';
            wrap.appendChild(bar);
            bar.addEventListener('click', async (e) => {
              const b = e.target.closest('button');
              if (!b) return;
              const a = b.dataset.a;
              if (a === 'in') { scale = Math.min(3, +(scale + 0.2).toFixed(2)); apply(); }
              else if (a === 'out') { scale = Math.max(0.4, +(scale - 0.2).toFixed(2)); apply(); }
              else if (a === 'reset') { scale = 1; apply(); }
              else if (a === 'fs') {
                try { if (!document.fullscreenElement) await wrap.requestFullscreen(); else await document.exitFullscreen(); } catch { wrap.classList.toggle('is-fullscreen'); }
              }
              else if (a === 'png') {
                const clone = svg.cloneNode(true);
                clone.style.transform = '';
                const s = new XMLSerializer().serializeToString(clone);
                const blob = new Blob([s], { type: 'image/svg+xml' });
                const url = URL.createObjectURL(blob);
                const img = new Image();
                img.onload = () => {
                  const pad = 16;
                  const w = img.width * 2 + pad * 2, h = img.height * 2 + pad * 2;
                  const c = document.createElement('canvas'); c.width = w; c.height = h;
                  const ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0,0,w,h);
                  ctx.drawImage(img, pad, pad, img.width*2, img.height*2);
                  URL.revokeObjectURL(url);
                  const a2 = document.createElement('a'); a2.download = 'mermaid.png'; a2.href = c.toDataURL('image/png'); a2.click();
                };
                img.onerror = () => URL.revokeObjectURL(url);
                img.src = url;
              }
            });
          });
        });
      }
    </script>
  </body>
</html>